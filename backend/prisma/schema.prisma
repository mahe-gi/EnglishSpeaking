datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum IdentityType {
  ANONYMOUS
  REGISTERED
}

enum Plan {
  FREE
  PREMIUM
}

enum VoiceSessionStatus {
  CREATED
  CONNECTING
  ACTIVE
  ENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum UsageType {
  AI
  PEER
}

enum SessionType {
  ASSESSMENT
  AI_PRACTICE
}

enum SessionStatus {
  IN_PROGRESS
  ANALYZING
  COMPLETED
  ABANDONED
}

enum PeerSlotStatus {
  AVAILABLE
  MATCHED
  EXPIRED
  CANCELLED
}

enum PeerMatchStatus {
  MATCHED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  SCHEDULED
  MISSED
}

enum PeerQueueStatus {
  WAITING
  MATCHED
  CANCELLED
  EXPIRED
}

model User {
  id                 String       @id @default(cuid())
  firebaseUid        String       @unique
  email              String?      @unique
  displayName        String?
  avatarUrl          String?
  identityType       IdentityType @default(ANONYMOUS)
  plan               Plan         @default(FREE)
  peerAgeConfirmedAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  profile            Profile?
  practiceSessions   PracticeSession[]
  voiceSessions      VoiceSession[]
  usageLedgers       UsageLedger[]
  peerAvailabilities PeerAvailability[]
  peerQueueEntry     PeerQueueEntry?

  peerMatchesAsA     PeerMatch[] @relation("PeerMatchUserA")
  peerMatchesAsB     PeerMatch[] @relation("PeerMatchUserB")

  reportsFiled       Report[] @relation("ReportedBy")
  reportsReceived    Report[] @relation("ReportedAgainst")

  blocksInitiated    Block[] @relation("BlockerUser")
  blocksReceived     Block[] @relation("BlockedUser")

  sourceMergeIntents MergeIntent[] @relation("SourceUserIntents")
  targetMergeIntents MergeIntent[] @relation("TargetUserIntents")

  @@map("users")
}

model UsageLedger {
  id              String    @id @default(cuid())
  firebaseUid     String
  installationId  String?
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  type            UsageType
  sessionId       String
  billableSeconds Int
  planAtTime      Plan
  startedAt       DateTime
  endedAt         DateTime
  idempotencyKey  String?   @unique
  createdAt       DateTime  @default(now())

  @@index([firebaseUid, type, createdAt])
  @@index([installationId, type, createdAt])
  @@index([userId, type, createdAt])
  @@map("usage_ledgers")
}

model VoiceSession {
  id                   String             @id @default(cuid())
  roomName             String?            @unique
  firebaseUid          String
  installationId       String?
  userId               String?
  user                 User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  status               VoiceSessionStatus @default(CREATED)
  allowedSeconds       Int
  reservedSeconds      Int
  actualSeconds        Int                @default(0)
  startedAt            DateTime?
  endedAt              DateTime?
  reservationExpiresAt DateTime?
  idempotencyKey       String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([firebaseUid, status])
  @@index([installationId, status])
  @@index([userId, status])
  @@index([status, reservationExpiresAt])
  @@map("voice_sessions")
}

model MergeIntent {
  id                String    @id @default(cuid())
  sourceFirebaseUid String
  sourceUserId      String?
  sourceUser        User?     @relation("SourceUserIntents", fields: [sourceUserId], references: [id], onDelete: SetNull)
  targetUserId      String?
  targetUser        User?     @relation("TargetUserIntents", fields: [targetUserId], references: [id], onDelete: SetNull)
  installationId    String
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([sourceFirebaseUid, expiresAt])
  @@map("merge_intents")
}

model Profile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal                 String?
  careerStatus         String?
  nativeLanguage       String?
  confidence           Int?
  baselineScore        Int?
  currentScore         Int?
  weaknesses           Json?
  totalSpeakingSeconds Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("profiles")
}

model PracticeSession {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         SessionType   @default(AI_PRACTICE)
  scenario     String?
  status       SessionStatus @default(IN_PROGRESS)
  overallScore Int?
  metrics      Json?
  feedback     Json?
  startedAt    DateTime      @default(now())
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  utterances Utterance[]

  @@map("practice_sessions")
}

model Utterance {
  id              String          @id @default(cuid())
  sessionId       String
  practiceSession PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence        Int
  question        String
  transcript      String?
  audioDurationMs Int?
  wordCount       Int?
  wordsPerMinute  Float?
  fillerCount     Int?
  metrics         Json?
  createdAt       DateTime        @default(now())

  @@unique([sessionId, sequence])
  @@map("utterances")
}

model PeerQueueEntry {
  id        String          @id @default(cuid())
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    PeerQueueStatus @default(WAITING)
  matchId   String?
  expiresAt DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status, expiresAt])
  @@map("peer_queue_entries")
}

model PeerAvailability {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  goal      String?
  level     String?
  status    PeerSlotStatus @default(AVAILABLE)
  createdAt DateTime       @default(now())

  @@unique([userId, startsAt])
  @@map("peer_availabilities")
}

model PeerMatch {
  id             String          @id @default(cuid())
  userAId        String
  userBId        String
  userA          User            @relation("PeerMatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB          User            @relation("PeerMatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  status         PeerMatchStatus @default(MATCHED)
  livekitRoom    String          @unique
  allowedSeconds Int             @default(0)
  actualSeconds  Int             @default(0)
  matchedAt      DateTime        @default(now())
  startedAt      DateTime?
  endedAt        DateTime?
  deadlineAt     DateTime?
  startsAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt


  reports Report[]

  @@index([userAId, status])
  @@index([userBId, status])
  @@index([status, deadlineAt])
  @@map("peer_matches")
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String
  peerMatchId    String?
  reason         String
  details        String?
  createdAt      DateTime @default(now())

  reporter     User       @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User       @relation("ReportedAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)
  peerMatch    PeerMatch? @relation(fields: [peerMatchId], references: [id], onDelete: SetNull)

  @@map("reports")
}

model Block {
  id            String   @id @default(cuid())
  blockerId     String
  blockedUserId String
  createdAt     DateTime @default(now())

  blocker     User @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser User @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@map("blocks")
}

